{
  "files.encoding": "utf8",
  "files.eol": "\n",
  "editor.tabSize": 2,
  "editor.formatOnSave": false,
  "files.exclude": { "**/__pycache__": true, "**/.DS_Store": true },
  "liveServer.settings.root": "/",
  "liveServer.settings.port": 5500,
  "python.defaultInterpreterPath": "python",
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": { "index.html": "main.py, README.md, package.json" }
}
